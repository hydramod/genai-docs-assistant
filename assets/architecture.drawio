<mxfile host="drawio" type="device"><diagram id="architecture" name="Architecture"><mxGraphModel dx="1570" dy="840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1570" pageHeight="840" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value='&lt;b style="font-size:22px;color:#0F172A"&gt;genai-docs-assistant&lt;/b&gt;&lt;span style="font-size:15px;color:#475569"&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;System architecture&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="900" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="Questions are answered only from the handbook, by plain RAG or by a LangGraph agent. Every Claude call goes through one gateway and is traced in Langfuse; an LLM judge scores the answers." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1200" height="22" as="geometry"/></mxCell><mxCell id="L1" value="1 · Ingestion (offline)" style="swimlane;html=1;startSize=34;rounded=1;arcSize=3;fillColor=#0F766E;fontColor=#FFFFFF;swimlaneFillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;align=left;spacingLeft=14;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="280" height="480" as="geometry"/></mxCell><mxCell id="docs" value='&lt;b&gt;Handbook&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;docs/*.md&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;5 files · 25 paragraphs&lt;/span&gt;' style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="30" y="62" width="220" height="86" as="geometry"/></mxCell><mxCell id="chunk" value='&lt;b&gt;ingest.py&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;chunk_text()&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;500 chars · 100 overlap&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="30" y="196" width="220" height="80" as="geometry"/></mxCell><mxCell id="chroma" value='&lt;b&gt;Chroma&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;local vector store&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;all-MiniLM-L6-v2 · cosine&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;15 chunks&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=14;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="30" y="322" width="220" height="128" as="geometry"/></mxCell><mxCell id="L2" value="2 · Application (query time)" style="swimlane;html=1;startSize=34;rounded=1;arcSize=3;fillColor=#1D4ED8;fontColor=#FFFFFF;swimlaneFillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;align=left;spacingLeft=14;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="620" height="480" as="geometry"/></mxCell><mxCell id="question" value="&lt;b&gt;Member&lt;br&gt;question&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;arcSize=30;fontColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="L2"><mxGeometry x="16" y="225" width="110" height="60" as="geometry"/></mxCell><mxCell id="rag" value="assistant.py · RAG pipeline" style="rounded=1;arcSize=3;html=1;dashed=1;dashPattern=6 4;fillColor=#FFFFFF;strokeColor=#1D4ED8;verticalAlign=top;align=right;spacingRight=12;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#1D4ED8;" vertex="1" parent="L2"><mxGeometry x="150" y="55" width="450" height="150" as="geometry"/></mxCell><mxCell id="retrieve" value='&lt;b&gt;retrieve()&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;top-k chunks&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="rag"><mxGeometry x="20" y="45" width="125" height="80" as="geometry"/></mxCell><mxCell id="prompt" value='&lt;b&gt;build_prompt()&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;excerpts + question&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="rag"><mxGeometry x="162" y="45" width="125" height="80" as="geometry"/></mxCell><mxCell id="generate" value='&lt;b&gt;generate()&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;answers from&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;excerpts only&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="rag"><mxGeometry x="305" y="45" width="125" height="80" as="geometry"/></mxCell><mxCell id="agent" value="agent.py · LangGraph agent" style="rounded=1;arcSize=3;html=1;dashed=1;dashPattern=6 4;fillColor=#FFFFFF;strokeColor=#1D4ED8;verticalAlign=top;align=right;spacingRight=12;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#1D4ED8;" vertex="1" parent="L2"><mxGeometry x="150" y="245" width="450" height="200" as="geometry"/></mxCell><mxCell id="model" value='&lt;b&gt;model node&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;Claude decides:&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;use a tool or answer&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="agent"><mxGeometry x="20" y="50" width="120" height="95" as="geometry"/></mxCell><mxCell id="tools" value='&lt;b&gt;tools node&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;runs tool&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;calls&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="agent"><mxGeometry x="210" y="50" width="88" height="95" as="geometry"/></mxCell><mxCell id="search" value='&lt;b&gt;search_handbook&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;reuses retrieve()&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="agent"><mxGeometry x="320" y="36" width="120" height="56" as="geometry"/></mxCell><mxCell id="calc" value='&lt;b&gt;calculator&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;safe AST parser&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="agent"><mxGeometry x="320" y="108" width="120" height="56" as="geometry"/></mxCell><mxCell id="agent_note" value="loop ends on a final answer, or after 6 model calls" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#475569;" vertex="1" parent="agent"><mxGeometry x="120" y="170" width="320" height="20" as="geometry"/></mxCell><mxCell id="L3" value="3 · LLM gateway" style="swimlane;html=1;startSize=34;rounded=1;arcSize=3;fillColor=#6D28D9;fontColor=#FFFFFF;swimlaneFillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;align=left;spacingLeft=14;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="250" height="480" as="geometry"/></mxCell><mxCell id="gateway" value='&lt;b&gt;llm.py · call_claude()&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;•&amp;nbsp;retry · exponential backoff + jitter&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;•&amp;nbsp;refusal fallbacks&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;•&amp;nbsp;structured output (judge)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;•&amp;nbsp;token + cost tracking&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;•&amp;nbsp;API keys from .env&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="L3"><mxGeometry x="20" y="114" width="210" height="300" as="geometry"/></mxCell><mxCell id="L4" value="4 · External services" style="swimlane;html=1;startSize=34;rounded=1;arcSize=3;fillColor=#334155;fontColor=#FFFFFF;swimlaneFillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;align=left;spacingLeft=14;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1280" y="100" width="250" height="480" as="geometry"/></mxCell><mxCell id="anthropic" value='&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;Claude Opus 5.5&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;adaptive thinking&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;low / medium effort&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="L4"><mxGeometry x="20" y="114" width="210" height="112" as="geometry"/></mxCell><mxCell id="langfuse" value='&lt;b&gt;Langfuse Cloud&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;one trace per question&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;spans · generations&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;cost · judge scores&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="L4"><mxGeometry x="20" y="330" width="210" height="112" as="geometry"/></mxCell><mxCell id="L5" value="5 · Evaluation · evaluate.py" style="swimlane;html=1;startSize=34;rounded=1;arcSize=3;fillColor=#B45309;fontColor=#FFFFFF;swimlaneFillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;align=left;spacingLeft=14;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="1210" height="200" as="geometry"/></mxCell><mxCell id="evalset" value='&lt;b&gt;eval_set.json&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;12 questions + notes&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;2 deliberately unanswerable&lt;/span&gt;' style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="L5"><mxGeometry x="30" y="62" width="210" height="96" as="geometry"/></mxCell><mxCell id="runner" value='&lt;b&gt;evaluate_case()&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;runs RAG (or --agent)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;on every question&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="L5"><mxGeometry x="290" y="66" width="220" height="88" as="geometry"/></mxCell><mxCell id="judge" value='&lt;b&gt;judge()&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;score 1–5 with a reason&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;checks claims against the full handbook&lt;/span&gt;' style="rounde