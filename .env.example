# Copy this file to .env and fill in your own keys. .env is in .gitignore - never commit it.

# Required: your Anthropic API key, from https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional: Langfuse tracing (Step 4). Keys come from your Langfuse project settings.
# Leave these blank and tracing is simply switched off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
